# Postgres connection (embedded-postgres dev server defaults shown)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/workspring
# Where the embedded dev Postgres keeps its data (default: .data/pg inside the repo)
WS_PG_DATA=.data/pg
WS_PG_PORT=54329
# Public base URL used in emails/links
APP_URL=http://localhost:3000
# Payments: "test" (simulated provider, TEST MODE) or "unconfigured". Live providers are not implemented.
PAYMENTS_PROVIDER=test
TEST_PROVIDER_WEBHOOK_SECRET=change-me-test-webhook-secret-at-least-32-chars
# Show the dev email outbox viewer at /dev/outbox (always on when NODE_ENV=development)
ENABLE_DEV_OUTBOX=false
