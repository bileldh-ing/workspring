# ---- Database ---------------------------------------------------------------
# Postgres connection. `pnpm db:start` runs an embedded PostgreSQL 17 with these defaults.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/workspring
WS_PG_DATA=.data/pg
WS_PG_PORT=54329

# ---- App -------------------------------------------------------------------
# Public base URL used in emails/links (https:// in production enables HSTS + upgrade-insecure-requests)
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---- Payments ----------------------------------------------------------------
# "test" (simulated provider, TEST MODE, no real money) or anything else = explicitly unconfigured.
PAYMENTS_PROVIDER=test
TEST_PROVIDER_WEBHOOK_SECRET=change-me-test-webhook-secret-at-least-32-chars

# ---- Private file storage ------------------------------------------------------
# HMAC secret for short-lived signed download URLs (required in production, 32+ chars)
FILE_URL_SECRET=change-me-file-url-secret-at-least-32-chars
# local (default; files under STORAGE_DIR, outside public/) or s3 (any S3-compatible private bucket)
STORAGE_DRIVER=local
STORAGE_DIR=.storage
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ---- Video interviews (optional) ----------------------------------------------
# Leave all three empty to show "video not configured". Set all three to enable LiveKit tokens.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ---- Rate limiting -------------------------------------------------------------
# db (default, shared across instances) or memory (single process)
RATE_LIMIT_DRIVER=db

# Show the dev email outbox viewer at /dev/outbox (always on when NODE_ENV=development)
ENABLE_DEV_OUTBOX=false
